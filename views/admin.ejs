<%- include('header') %>

<div class="max-w-5xl w-full mx-auto px-4 py-8">

  <!-- Admin Nav -->
  <div class="flex flex-wrap items-center justify-between gap-4 mb-6 pb-4 border-b border-dark-800">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 bg-brand-500 text-white rounded-xl flex items-center justify-center font-black text-xl shadow-lg shadow-brand-500/20">
        M
      </div>
      <div>
        <h1 class="text-lg font-bold text-white">Mirror Hub Admin</h1>
        <p class="text-xs text-slate-400">Manage releases, hosts & download metrics</p>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <button onclick="openCreateModal()" class="px-4 py-2 bg-brand-500 hover:bg-brand-600 text-white text-xs font-semibold rounded-xl transition flex items-center gap-2 shadow-lg shadow-brand-500/20">
        <i class="fa-solid fa-plus"></i> New Release
      </button>
      <a href="/admin/logout" class="px-3 py-2 bg-dark-800 hover:bg-dark-700 text-slate-300 text-xs font-semibold rounded-xl transition border border-dark-700">
        Logout
      </a>
    </div>
  </div>

  <!-- ANALYTICS SUMMARY OVERVIEW BAR -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-8">
    <div class="bg-dark-900 border border-dark-800 p-4 rounded-2xl shadow-lg">
      <p class="text-[11px] font-semibold uppercase text-slate-400">Total Downloads</p>
      <p class="text-2xl font-black text-white mt-1"><%= stats.totalDownloads %></p>
      <p class="text-[10px] text-brand-500 mt-0.5"><i class="fa-solid fa-chart-line mr-1"></i>All-time clicks</p>
    </div>
    <div class="bg-dark-900 border border-dark-800 p-4 rounded-2xl shadow-lg">
      <p class="text-[11px] font-semibold uppercase text-slate-400">Past 24 Hours</p>
      <p class="text-2xl font-black text-emerald-400 mt-1"><%= stats.downloads24h %></p>
      <p class="text-[10px] text-slate-500 mt-0.5">Recent traffic</p>
    </div>
    <div class="bg-dark-900 border border-dark-800 p-4 rounded-2xl shadow-lg">
      <p class="text-[11px] font-semibold uppercase text-slate-400">Top Host</p>
      <p class="text-base font-bold text-white truncate mt-1"><%= stats.topHostName %></p>
      <p class="text-[10px] text-slate-400 mt-0.5"><%= stats.topHostClicks %> clicks recorded</p>
    </div>
    <div class="bg-dark-900 border border-dark-800 p-4 rounded-2xl shadow-lg">
      <p class="text-[11px] font-semibold uppercase text-slate-400">Active Releases</p>
      <p class="text-2xl font-black text-white mt-1"><%= releases.length %></p>
      <p class="text-[10px] text-slate-500 mt-0.5">Public links live</p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    <!-- RELEASES LIST -->
    <div class="lg:col-span-2 space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="font-bold text-white text-sm">Active Releases (<%= releases.length %>)</h2>
      </div>

      <div class="bg-dark-900 border border-dark-800 rounded-3xl overflow-hidden shadow-xl divide-y divide-dark-800/60">
        <% if (releases.length === 0) { %>
          <div class="text-center py-16 text-slate-500">
            <i class="fa-solid fa-box-open text-4xl mb-3 opacity-40"></i>
            <p class="text-sm">No releases created yet.</p>
          </div>
        <% } else { %>
          <% releases.forEach(r => { 
            const releaseBase64 = Buffer.from(JSON.stringify(r)).toString('base64');
          %>
            <div class="p-4 sm:p-5 flex flex-col gap-3 hover:bg-dark-800/30 transition">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div class="space-y-1">
                  <div class="flex items-center gap-2">
                    <span class="font-bold text-white text-base"><%= r.title %></span>
                    <span class="text-[10px] uppercase font-bold px-2 py-0.5 rounded-full <%= r.mode === 'simple' ? 'bg-indigo-500/10 text-indigo-400 border border-indigo-500/20' : 'bg-brand-500/10 text-brand-400 border border-brand-500/20' %>">
                      <%= r.mode %>
                    </span>
                  </div>
                  <div class="text-xs text-slate-400 flex flex-wrap items-center gap-3">
                    <span class="font-mono text-brand-500">/<%= r.slug %></span>
                    <span>&bull;</span>
                    <span><%= r.mirror_count %> mirrors</span>
                    <span>&bull;</span>
                    <span class="text-white font-semibold"><i class="fa-solid fa-download mr-1 text-brand-500"></i><%= r.total_clicks %> clicks</span>
                  </div>
                </div>

                <div class="flex items-center gap-1.5 shrink-0 flex-wrap">
                  <button type="button" onclick="openEditModal(this)" data-json="<%= releaseBase64 %>" class="px-2.5 py-1.5 bg-dark-800 hover:bg-dark-700 text-slate-300 text-xs font-semibold rounded-xl transition border border-dark-700 flex items-center gap-1" title="Edit Release">
                    <i class="fa-solid fa-pen-to-square text-brand-500 pointer-events-none"></i> Edit
                  </button>
                  <button type="button" onclick="openBBCodeModal(this)" data-json="<%= releaseBase64 %>" class="px-2.5 py-1.5 bg-dark-800 hover:bg-dark-700 text-slate-300 text-xs font-semibold rounded-xl transition border border-dark-700 flex items-center gap-1" title="Copy XDA BBCode">
                    <i class="fa-solid fa-code text-brand-500 pointer-events-none"></i> BBCode
                  </button>
                  <a href="/<%= r.slug %>" target="_blank" class="px-2.5 py-1.5 bg-dark-800 hover:bg-dark-700 text-slate-300 text-xs font-semibold rounded-xl transition border border-dark-700">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                  </a>
                  <form action="/admin/release/<%= r.id %>/delete" method="POST" onsubmit="return confirm('Delete this release and its analytics?')">
                    <button type="submit" class="px-2.5 py-1.5 bg-red-500/10 hover:bg-red-500 text-red-400 hover:text-white text-xs font-semibold rounded-xl transition border border-red-500/20">
                      <i class="fa-solid fa-trash"></i>
                    </button>
                  </form>
                </div>
              </div>

              <!-- Host Analytics Breakdown per Mirror -->
              <% if (r.mirrors && r.mirrors.length > 0) { %>
                <div class="bg-dark-950/80 p-3 rounded-2xl border border-dark-800 space-y-1.5 mt-1">
                  <div class="text-[11px] font-semibold text-slate-400 mb-1 flex justify-between">
                    <span>Mirror Click Breakdown</span>
                    <span class="font-mono text-slate-500"><%= r.total_clicks %> total</span>
                  </div>
                  <% r.mirrors.forEach(m => { 
                    const percent = r.total_clicks > 0 ? Math.round((m.clicks / r.total_clicks) * 100) : 0;
                  %>
                    <div class="space-y-0.5">
                      <div class="flex justify-between text-xs font-medium">
                        <span class="text-slate-300"><%= m.provider %></span>
                        <span class="text-slate-400 font-mono"><%= m.clicks %> clicks (<%= percent %>%)</span>
                      </div>
                      <div class="w-full h-1.5 bg-dark-800 rounded-full overflow-hidden">
                        <div class="h-full bg-brand-500 rounded-full" style="width: <%= percent %>%"></div>
                      </div>
                    </div>
                  <% }); %>
                </div>
              <% } %>

            </div>
          <% }); %>
        <% } %>
      </div>
    </div>

    <!-- UNIVERSAL SPOTIFY-STYLE HOST PLAYLIST -->
    <div class="space-y-4">
      <div>
        <h2 class="font-bold text-white text-sm">Universal Host Priority</h2>
        <p class="text-xs text-slate-400">Drag hosts to change their rank globally.</p>
      </div>

      <div class="flex gap-2">
        <input type="text" id="newHostName" placeholder="Add custom host (e.g. Gofile)" class="flex-grow bg-dark-900 border border-dark-700 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-brand-500">
        <button onclick="addCustomHost()" class="px-3 py-2 bg-dark-800 hover:bg-dark-700 border border-dark-700 text-brand-500 text-xs font-bold rounded-xl transition">
          + Add
        </button>
      </div>

      <div id="universalHostsList" class="bg-dark-900 border border-dark-800 rounded-3xl p-3 space-y-2 shadow-xl">
        <% hosts.forEach((h, idx) => { %>
          <div class="host-item flex items-center justify-between p-2.5 bg-dark-800/80 border border-dark-700/60 rounded-2xl cursor-default transition" data-id="<%= h.id %>">
            <div class="flex items-center gap-3">
              <div class="drag-handle cursor-grab active:cursor-grabbing text-slate-500 hover:text-brand-500 px-1">
                <i class="fa-solid fa-grip-vertical"></i>
              </div>
              <span class="host-rank text-xs font-mono font-bold text-slate-500 w-5">#<%= idx + 1 %></span>
              <span class="text-xs font-semibold text-white"><%= h.name %></span>
            </div>
            <button onclick="deleteHost(<%= h.id %>)" class="text-slate-500 hover:text-red-400 p-1.5 transition text-xs">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </div>
        <% }); %>
      </div>
      <p id="saveStatus" class="text-[11px] text-emerald-500 text-center hidden"><i class="fa-solid fa-check mr-1"></i>Priority updated universally!</p>
    </div>

  </div>
</div>

<!-- ==================== RELEASE CREATE / EDIT MODAL ==================== -->
<div id="releaseModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
  <div class="bg-dark-900 border border-dark-700 rounded-3xl w-full max-w-2xl max-h-[90vh] flex flex-col shadow-2xl overflow-hidden">
    
    <div class="p-6 border-b border-dark-800 flex items-center justify-between">
      <div>
        <h3 id="modalHeading" class="text-lg font-bold text-white">Create New Release</h3>
        <p class="text-xs text-slate-400">Hosts will automatically sort by your Universal Priority</p>
      </div>
      <button type="button" onclick="document.getElementById('releaseModal').classList.add('hidden')" class="text-slate-400 hover:text-white">
        <i class="fa-solid fa-xmark text-lg"></i>
      </button>
    </div>

    <form id="releaseForm" class="p-6 overflow-y-auto space-y-5 flex-grow">
      <input type="hidden" id="editReleaseId" value="">
      
      <!-- MODE TOGGLE -->
      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Display Style Mode</label>
        <div class="grid grid-cols-2 gap-3">
          <label class="flex items-center gap-3 p-3 rounded-2xl border border-dark-700 bg-dark-800 cursor-pointer has-[:checked]:border-brand-500 has-[:checked]:bg-brand-500/10">
            <input type="radio" id="modeSimple" name="mode" value="simple" onchange="toggleMode('simple')" class="accent-brand-500">
            <div>
              <div class="text-sm font-bold text-white">Simple</div>
              <div class="text-[11px] text-slate-400">Just filename & mirrors</div>
            </div>
          </label>
          <label class="flex items-center gap-3 p-3 rounded-2xl border border-dark-700 bg-dark-800 cursor-pointer has-[:checked]:border-brand-500 has-[:checked]:bg-brand-500/10">
            <input type="radio" id="modeComplex" name="mode" value="complex" checked onchange="toggleMode('complex')" class="accent-brand-500">
            <div>
              <div class="text-sm font-bold text-white">Complex</div>
              <div class="text-[11px] text-slate-400">Hashes, device, changelog</div>
            </div>
          </label>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-1">Title / Filename *</label>
          <input type="text" id="title" required placeholder="recovery.img or ROM-v1.0.zip" class="w-full bg-dark-800 border border-dark-700 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-brand-500">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-1">URL Slug *</label>
          <div class="flex items-center bg-dark-800 border border-dark-700 rounded-xl px-3 py-2">
            <span class="text-xs text-slate-500">/</span>
            <input type="text" id="slug" required placeholder="recovery-shiba" class="w-full bg-transparent text-sm text-white focus:outline-none ml-1">
          </div>
        </div>
      </div>

      <!-- Complex fields -->
      <div id="complexFields" class="space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div>
            <label class="block text-xs font-semibold text-slate-400 mb-1">Device Codename</label>
            <input type="text" id="device" placeholder="Pixel 8 (shiba)" class="w-full bg-dark-800 border border-dark-700 rounded-xl px-3 py-2 text-sm text-white focus:outline-none">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-400 mb-1">Build / Version</label>
            <input type="text" id="version" placeholder="v1.0-Official" class="w-full bg-dark-800 border border-dark-700 rounded-xl px-3 py-2 text-sm text-white focus:outline-none">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-400 mb-1">File Size</label>
            <input type="text" id="file_size" placeholder="64 MB / 1.8 GB" class="w-full bg-dark-800 border border-dark-700 rounded-xl px-3 py-2 text-sm text-white focus:outline-none">
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-slate-400 mb-1">MD5 Checksum</label>
            <input type="text" id="md5" placeholder="c282002da283..." class="w-full bg-dark-800 border border-dark-700 rounded-xl px-3 py-2 text-sm text-white font-mono focus:outline-none">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-400 mb-1">SHA256 Checksum</label>
            <input type="text" id="sha256" placeholder="a3b59f..." class="w-full bg-dark-800 border border-dark-700 rounded-xl px-3 py-2 text-sm text-white font-mono focus:outline-none">
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-1">Changelog (Markdown)</label>
          <textarea id="changelog" rows="2" placeholder="- Initial build&#10;- Fixed touchscreen" class="w-full bg-dark-800 border border-dark-700 rounded-xl px-3 py-2 text-sm text-white font-mono focus:outline-none"></textarea>
        </div>
      </div>

      <!-- MIRROR LINKS SECTION -->
      <div>
        <div class="flex items-center justify-between mb-2">
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-400">Mirror Download Links</label>
          <button type="button" onclick="addMirrorInputRow()" class="px-2.5 py-1 bg-dark-800 hover:bg-dark-700 text-brand-500 text-xs font-bold rounded-lg border border-dark-700 transition">
            + Add Link
          </button>
        </div>
        <div id="releaseMirrorsContainer" class="space-y-2"></div>
      </div>

    </form>

    <div class="p-6 border-t border-dark-800 bg-dark-900 flex justify-end gap-3">
      <button type="button" onclick="document.getElementById('releaseModal').classList.add('hidden')" class="px-4 py-2 bg-dark-800 hover:bg-dark-700 text-slate-300 text-xs font-semibold rounded-xl transition">
        Cancel
      </button>
      <button type="button" onclick="submitRelease()" id="btnSubmitRelease" class="px-6 py-2 bg-brand-500 hover:bg-brand-600 text-white text-xs font-semibold rounded-xl transition shadow-lg shadow-brand-500/20">
        Publish Release
      </button>
    </div>

  </div>
</div>

<!-- ==================== BBCODE GENERATOR MODAL ==================== -->
<div id="bbcodeModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
  <div class="bg-dark-900 border border-dark-700 rounded-3xl w-full max-w-lg shadow-2xl overflow-hidden flex flex-col">
    <div class="p-5 border-b border-dark-800 flex items-center justify-between">
      <div>
        <h3 class="text-base font-bold text-white"><i class="fa-solid fa-code text-brand-500 mr-1.5"></i>XDA Forum BBCode</h3>
        <p class="text-xs text-slate-400">Ready to paste directly into your XDA thread</p>
      </div>
      <button type="button" onclick="document.getElementById('bbcodeModal').classList.add('hidden')" class="text-slate-400 hover:text-white">
        <i class="fa-solid fa-xmark text-lg"></i>
      </button>
    </div>

    <div class="p-5 space-y-4">
      <div class="flex gap-2">
        <button type="button" onclick="switchBBCodeStyle('button')" id="btnBBStyleButton" class="flex-1 py-1.5 text-xs font-bold rounded-xl bg-brand-500 text-white transition">
          Direct Button
        </button>
        <button type="button" onclick="switchBBCodeStyle('full')" id="btnBBStyleFull" class="flex-1 py-1.5 text-xs font-bold rounded-xl bg-dark-800 text-slate-300 border border-dark-700 transition">
          Full Release Post
        </button>
      </div>

      <textarea id="bbcodeOutput" rows="6" readonly class="w-full bg-dark-950 border border-dark-800 rounded-2xl p-3 text-xs font-mono text-slate-200 select-all focus:outline-none focus:border-brand-500"></textarea>

      <button type="button" onclick="copyBBCodeToClipboard()" class="w-full py-2.5 bg-brand-500 hover:bg-brand-600 text-white font-bold text-xs rounded-xl transition flex items-center justify-center gap-2 shadow-lg shadow-brand-500/20">
        <i class="fa-regular fa-copy" id="bbCopyIcon"></i> <span id="bbCopyText">Copy BBCode</span>
      </button>
    </div>
  </div>
</div>

<script>
  let activeBBCodeRelease = null;
  const currentHost = "<%= host %>";
  const currentProtocol = "<%= protocol %>";
  const globalHosts = JSON.parse(decodeURIComponent(escape(atob("<%= Buffer.from(JSON.stringify(hosts)).toString('base64') %>"))));

  // Helper to safely parse release from button dataset
  function getReleaseFromBtn(btn) {
    try {
      const base64 = btn.getAttribute('data-json');
      return JSON.parse(decodeURIComponent(escape(atob(base64))));
    } catch (e) {
      console.error('Error decoding release:', e);
      return null;
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const hostListEl = document.getElementById('universalHostsList');
    if (hostListEl) {
      Sortable.create(hostListEl, {
        animation: 150,
        handle: '.drag-handle',
        ghostClass: 'ghost-item',
        onEnd: async () => {
          updateHostRanks();
          await saveUniversalHostOrder();
        }
      });
    }
  });

  function updateHostRanks() {
    const items = document.querySelectorAll('.host-item');
    items.forEach((item, i) => {
      item.querySelector('.host-rank').innerText = '#' + (i + 1);
    });
  }

  async function saveUniversalHostOrder() {
    const items = document.querySelectorAll('.host-item');
    const orderedHostIds = Array.from(items).map(el => parseInt(el.getAttribute('data-id')));
    
    const res = await fetch('/admin/hosts/reorder', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ orderedHostIds })
    });

    if (res.ok) {
      const status = document.getElementById('saveStatus');
      status.classList.remove('hidden');
      setTimeout(() => status.classList.add('hidden'), 2000);
    }
  }

  async function addCustomHost() {
    const nameInput = document.getElementById('newHostName');
    const name = nameInput.value.trim();
    if (!name) return;

    const res = await fetch('/admin/hosts/add', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name })
    });

    if (res.ok) window.location.reload();
  }

  async function deleteHost(id) {
    if (!confirm('Remove this host from universal list?')) return;
    const res = await fetch('/admin/hosts/' + id + '/delete', { method: 'POST' });
    if (res.ok) window.location.reload();
  }

  function toggleMode(mode) {
    const complexFields = document.getElementById('complexFields');
    if (mode === 'simple') {
      complexFields.classList.add('hidden');
    } else {
      complexFields.classList.remove('hidden');
    }
  }

  function addMirrorInputRow(provider = '', url = '') {
    const container = document.getElementById('releaseMirrorsContainer');
    const row = document.createElement('div');
    row.className = 'mirror-input-row flex items-center gap-2 p-2 bg-dark-950 border border-dark-800 rounded-xl';
    
    let hostOptions = globalHosts.map(h => 
      `<option value="${h.name}" ${h.name.toLowerCase() === provider.toLowerCase() ? 'selected' : ''}>${h.name}</option>`
    ).join('');

    row.innerHTML = `
      <select class="mirror-provider bg-dark-800 border border-dark-700 rounded-lg px-2.5 py-1.5 text-xs text-white focus:outline-none">
        ${hostOptions}
      </select>
      <input type="url" placeholder="Paste download URL (https://...)" value="${url}" class="mirror-url flex-grow bg-dark-800 border border-dark-700 rounded-lg px-2.5 py-1.5 text-xs text-white focus:outline-none focus:border-brand-500">
      <button type="button" onclick="this.closest('.mirror-input-row').remove();" class="text-slate-500 hover:text-red-400 p-1.5 transition">
        <i class="fa-solid fa-trash-can"></i>
      </button>
    `;
    container.appendChild(row);
  }

  // ==================== CREATE MODAL OPEN ====================
  function openCreateModal() {
    document.getElementById('editReleaseId').value = '';
    document.getElementById('modalHeading').innerText = 'Create New Release';
    document.getElementById('btnSubmitRelease').innerText = 'Publish Release';
    document.getElementById('title').value = '';
    document.getElementById('slug').value = '';
    document.getElementById('device').value = '';
    document.getElementById('version').value = '';
    document.getElementById('file_size').value = '';
    document.getElementById('md5').value = '';
    document.getElementById('sha256').value = '';
    document.getElementById('changelog').value = '';
    document.getElementById('modeComplex').checked = true;
    toggleMode('complex');

    const container = document.getElementById('releaseMirrorsContainer');
    container.innerHTML = '';
    addMirrorInputRow('GitHub Releases', '');
    addMirrorInputRow('Catbox', '');
    addMirrorInputRow('Google Drive', '');

    document.getElementById('releaseModal').classList.remove('hidden');
  }

  // ==================== EDIT MODAL OPEN ====================
  function openEditModal(btn) {
    const r = getReleaseFromBtn(btn);
    if (!r) return;

    document.getElementById('editReleaseId').value = r.id;
    document.getElementById('modalHeading').innerText = 'Edit Release: ' + r.title;
    document.getElementById('btnSubmitRelease').innerText = 'Save Changes';
    document.getElementById('title').value = r.title || '';
    document.getElementById('slug').value = r.slug || '';
    document.getElementById('device').value = r.device || '';
    document.getElementById('version').value = r.version || '';
    document.getElementById('file_size').value = r.file_size || '';
    document.getElementById('md5').value = r.md5 || '';
    document.getElementById('sha256').value = r.sha256 || '';
    document.getElementById('changelog').value = r.changelog || '';

    if (r.mode === 'simple') {
      document.getElementById('modeSimple').checked = true;
      toggleMode('simple');
    } else {
      document.getElementById('modeComplex').checked = true;
      toggleMode('complex');
    }

    const container = document.getElementById('releaseMirrorsContainer');
    container.innerHTML = '';
    if (r.mirrors && r.mirrors.length > 0) {
      r.mirrors.forEach(m => addMirrorInputRow(m.provider, m.url));
    } else {
      addMirrorInputRow('GitHub Releases', '');
    }

    document.getElementById('releaseModal').classList.remove('hidden');
  }

  // ==================== SUBMIT CREATE / EDIT ====================
  async function submitRelease() {
    const editId = document.getElementById('editReleaseId').value;
    const isEdit = Boolean(editId);
    const mode = document.querySelector('input[name="mode"]:checked').value;
    const title = document.getElementById('title').value.trim();
    const slug = document.getElementById('slug').value.trim();

    if (!title || !slug) {
      alert('Please fill out the Title and URL Slug.');
      return;
    }

    const rows = document.querySelectorAll('.mirror-input-row');
    const mirrors = [];
    rows.forEach(r => {
      const provider = r.querySelector('.mirror-provider').value;
      const url = r.querySelector('.mirror-url').value.trim();
      if (url) mirrors.push({ provider, url });
    });

    const payload = {
      title,
      slug,
      mode,
      device: document.getElementById('device').value,
      version: document.getElementById('version').value,
      file_size: document.getElementById('file_size').value,
      md5: document.getElementById('md5').value,
      sha256: document.getElementById('sha256').value,
      changelog: document.getElementById('changelog').value,
      mirrors
    };

    const targetUrl = isEdit ? `/admin/release/${editId}/edit` : '/admin/release';

    const res = await fetch(targetUrl, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });

    const result = await res.json();
    if (res.ok && result.success) {
      window.location.reload();
    } else {
      alert(result.error || 'Failed to save release.');
    }
  }

  // ==================== ROBUST BBCODE GENERATOR ====================
  function openBBCodeModal(btn) {
    const r = getReleaseFromBtn(btn);
    if (!r) return;

    activeBBCodeRelease = r;
    switchBBCodeStyle('button');
    document.getElementById('bbcodeModal').classList.remove('hidden');
  }

  function switchBBCodeStyle(style) {
    if (!activeBBCodeRelease) return;
    const r = activeBBCodeRelease;
    const fullUrl = `${currentProtocol}://${currentHost}/${r.slug}`;
    const btnButton = document.getElementById('btnBBStyleButton');
    const btnFull = document.getElementById('btnBBStyleFull');
    const output = document.getElementById('bbcodeOutput');

    if (style === 'button') {
      btnButton.className = "flex-1 py-1.5 text-xs font-bold rounded-xl bg-brand-500 text-white transition";
      btnFull.className = "flex-1 py-1.5 text-xs font-bold rounded-xl bg-dark-800 text-slate-300 border border-dark-700 transition";
      output.value = `[CENTER][B][SIZE=5]${r.title}[/SIZE][/B]\n[URL='${fullUrl}'][SIZE=4][B][COLOR=#f97316]⚡ Download via Fast Mirrors[/COLOR][/B][/SIZE][/URL][/CENTER]`;
    } else {
      btnFull.className = "flex-1 py-1.5 text-xs font-bold rounded-xl bg-brand-500 text-white transition";
      btnButton.className = "flex-1 py-1.5 text-xs font-bold rounded-xl bg-dark-800 text-slate-300 border border-dark-700 transition";
      
      let fullCode = `[CENTER][B][SIZE=5]${r.title}[/SIZE][/B][/CENTER]\n\n`;
      if (r.device) fullCode += `[B]Device:[/B] ${r.device}\n`;
      if (r.version) fullCode += `[B]Version:[/B] ${r.version}\n`;
      if (r.file_size) fullCode += `[B]Size:[/B] ${r.file_size}\n`;
      if (r.md5) fullCode += `[B]MD5:[/B] [FONT=monospace]${r.md5}[/FONT]\n`;
      if (r.sha256) fullCode += `[B]SHA256:[/B] [FONT=monospace]${r.sha256}[/FONT]\n`;
      fullCode += `\n[CENTER][URL='${fullUrl}'][SIZE=4][B][COLOR=#f97316]⚡ Download from Mirrors (Multi-Host)[/COLOR][/B][/SIZE][/URL][/CENTER]`;
      output.value = fullCode;
    }
  }

  function copyBBCodeToClipboard() {
    const textarea = document.getElementById('bbcodeOutput');
    textarea.select();
    textarea.setSelectionRange(0, 99999);

    try {
      document.execCommand('copy');
    } catch (e) {
      if (navigator.clipboard) {
        navigator.clipboard.writeText(textarea.value);
      }
    }

    const btnText = document.getElementById('bbCopyText');
    const btnIcon = document.getElementById('bbCopyIcon');
    btnText.innerText = 'Copied to Clipboard!';
    btnIcon.className = 'fa-solid fa-check';

    setTimeout(() => {
      btnText.innerText = 'Copy BBCode';
      btnIcon.className = 'fa-regular fa-copy';
    }, 2000);
  }
</script>

