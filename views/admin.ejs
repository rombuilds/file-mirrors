<%- include('layout', { body: `
<div class="max-w-5xl w-full mx-auto px-4 py-8">

  <!-- Admin Nav -->
  <div class="flex flex-wrap items-center justify-between gap-4 mb-8 pb-4 border-b border-dark-800">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 bg-brand-500 text-white rounded-xl flex items-center justify-center font-black text-xl shadow-lg shadow-brand-500/20">
        M
      </div>
      <div>
        <h1 class="text-lg font-bold text-white">Mirror Hub Admin</h1>
        <p class="text-xs text-slate-400">Manage releases & Universal Host Weights</p>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <button onclick="document.getElementById('createModal').classList.remove('hidden')" class="px-4 py-2 bg-brand-500 hover:bg-brand-600 text-white text-xs font-semibold rounded-xl transition flex items-center gap-2 shadow-lg shadow-brand-500/20">
        <i class="fa-solid fa-plus"></i> New Release
      </button>
      <a href="/admin/logout" class="px-3 py-2 bg-dark-800 hover:bg-dark-700 text-slate-300 text-xs font-semibold rounded-xl transition border border-dark-700">
        Logout
      </a>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    <!-- LEFT 2 COLUMNS: RELEASES -->
    <div class="lg:col-span-2 space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="font-bold text-white text-sm">Active Releases (${releases.length})</h2>
      </div>

      <div class="bg-dark-900 border border-dark-800 rounded-3xl overflow-hidden shadow-xl divide-y divide-dark-800/60">
        ${releases.length === 0 ? `
          <div class="text-center py-16 text-slate-500">
            <i class="fa-solid fa-box-open text-4xl mb-3 opacity-40"></i>
            <p class="text-sm">No releases created yet.</p>
          </div>
        ` : releases.map(r => `
          <div class="p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:bg-dark-800/30 transition">
            <div class="space-y-1">
              <div class="flex items-center gap-2">
                <span class="font-bold text-white text-base">${r.title}</span>
                <span class="text-[10px] uppercase font-bold px-2 py-0.5 rounded-full ${r.mode === 'simple' ? 'bg-indigo-500/10 text-indigo-400 border border-indigo-500/20' : 'bg-brand-500/10 text-brand-400 border border-brand-500/20'}">
                  ${r.mode}
                </span>
              </div>
              <div class="text-xs text-slate-400 flex flex-wrap items-center gap-3">
                <span class="font-mono text-brand-500">/${r.slug}</span>
                <span>&bull;</span>
                <span>${r.mirror_count} mirrors</span>
                <span>&bull;</span>
                <span>${r.total_clicks} downloads</span>
              </div>
            </div>

            <div class="flex items-center gap-2 shrink-0">
              <button onclick="copyBBCode('${r.title}', '${protocol}://${host}/${r.slug}')" class="px-2.5 py-1.5 bg-dark-800 hover:bg-dark-700 text-slate-300 text-xs font-semibold rounded-xl transition border border-dark-700 flex items-center gap-1.5" title="Copy XDA BBCode">
                <i class="fa-solid fa-code text-brand-500"></i> BBCode
              </button>
              <a href="/${r.slug}" target="_blank" class="px-2.5 py-1.5 bg-dark-800 hover:bg-dark-700 text-slate-300 text-xs font-semibold rounded-xl transition border border-dark-700">
                <i class="fa-solid fa-arrow-up-right-from-square"></i>
              </a>
              <form action="/admin/release/${r.id}/delete" method="POST" onsubmit="return confirm('Delete this release?')">
                <button type="submit" class="px-2.5 py-1.5 bg-red-500/10 hover:bg-red-500 text-red-400 hover:text-white text-xs font-semibold rounded-xl transition border border-red-500/20">
                  <i class="fa-solid fa-trash"></i>
                </button>
              </form>
            </div>
          </div>
        `).join('')}
      </div>
    </div>

    <!-- RIGHT 1 COLUMN: UNIVERSAL SPOTIFY-STYLE HOST PLAYLIST -->
    <div class="space-y-4">
      <div>
        <h2 class="font-bold text-white text-sm">Universal Host Priority</h2>
        <p class="text-xs text-slate-400">Drag hosts to change their rank globally.</p>
      </div>

      <!-- Add New Host Input -->
      <div class="flex gap-2">
        <input type="text" id="newHostName" placeholder="Add custom host (e.g. Pixeldrain)" class="flex-grow bg-dark-900 border border-dark-700 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-brand-500">
        <button onclick="addCustomHost()" class="px-3 py-2 bg-dark-800 hover:bg-dark-700 border border-dark-700 text-brand-500 text-xs font-bold rounded-xl transition">
          + Add
        </button>
      </div>

      <!-- Drag & Drop Host Playlist -->
      <div id="universalHostsList" class="bg-dark-900 border border-dark-800 rounded-3xl p-3 space-y-2 shadow-xl">
        ${hosts.map((h, idx) => `
          <div class="host-item flex items-center justify-between p-2.5 bg-dark-800/80 border border-dark-700/60 rounded-2xl cursor-default transition" data-id="${h.id}">
            <div class="flex items-center gap-3">
              <div class="drag-handle cursor-grab active:cursor-grabbing text-slate-500 hover:text-brand-500 px-1">
                <i class="fa-solid fa-grip-vertical"></i>
              </div>
              <span class="host-rank text-xs font-mono font-bold text-slate-500 w-5">#${idx + 1}</span>
              <span class="text-xs font-semibold text-white">${h.name}</span>
            </div>
            <button onclick="deleteHost(${h.id})" class="text-slate-500 hover:text-red-400 p-1.5 transition text-xs">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </div>
        `).join('')}
      </div>
      <p id="saveStatus" class="text-[11px] text-emerald-500 text-center hidden"><i class="fa-solid fa-check mr-1"></i>Priority updated universally!</p>
    </div>

  </div>
</div>

<!-- ==================== CREATE RELEASE MODAL ==================== -->
<div id="createModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
  <div class="bg-dark-900 border border-dark-700 rounded-3xl w-full max-w-2xl max-h-[90vh] flex flex-col shadow-2xl overflow-hidden">
    
    <div class="p-6 border-b border-dark-800 flex items-center justify-between">
      <div>
        <h3 class="text-lg font-bold text-white">Create New Release</h3>
        <p class="text-xs text-slate-400">Hosts will automatically sort by your Universal Priority</p>
      </div>
      <button onclick="document.getElementById('createModal').classList.add('hidden')" class="text-slate-400 hover:text-white">
        <i class="fa-solid fa-xmark text-lg"></i>
      </button>
    </div>

    <form id="releaseForm" class="p-6 overflow-y-auto space-y-5 flex-grow">
      
      <!-- MODE TOGGLE -->
      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Display Style Mode</label>
        <div class="grid grid-cols-2 gap-3">
          <label class="flex items-center gap-3 p-3 rounded-2xl border border-dark-700 bg-dark-800 cursor-pointer has-[:checked]:border-brand-500 has-[:checked]:bg-brand-500/10">
            <input type="radio" name="mode" value="simple" onchange="toggleMode('simple')" class="accent-brand-500">
            <div>
              <div class="text-sm font-bold text-white">Simple</div>
              <div class="text-[11px] text-slate-400">Just filename (e.g. recovery.img) & mirrors</div>
            </div>
          </label>
          <label class="flex items-center gap-3 p-3 rounded-2xl border border-dark-700 bg-dark-800 cursor-pointer has-[:checked]:border-brand-500 has-[:checked]:bg-brand-500/10">
            <input type="radio" name="mode" value="complex" checked onchange="toggleMode('complex')" class="accent-brand-500">
            <div>
              <div class="text-sm font-bold text-white">Complex</div>
              <div class="text-[11px] text-slate-400">Hashes, device, version, changelog</div>
            </div>
          </label>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-1">Title / Filename *</label>
          <input type="text" id="title" required placeholder="recovery.img or ROM-v1.0.zip" class="w-full bg-dark-800 border border-dark-700 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-brand-500">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-1">URL Slug *</label>
          <div class="flex items-center bg-dark-800 border border-dark-700 rounded-xl px-3 py-2">
            <span class="text-xs text-slate-500">/</span>
            <input type="text" id="slug" required placeholder="recovery-shiba" class="w-full bg-transparent text-sm text-white focus:outline-none ml-1">
          </div>
        </div>
      </div>

      <!-- Complex-only fields -->
      <div id="complexFields" class="space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div>
            <label class="block text-xs font-semibold text-slate-400 mb-1">Device Codename</label>
            <input type="text" id="device" placeholder="Pixel 8 (shiba)" class="w-full bg-dark-800 border border-dark-700 rounded-xl px-3 py-2 text-sm text-white focus:outline-none">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-400 mb-1">Build / Version</label>
            <input type="text" id="version" placeholder="v1.0-Official" class="w-full bg-dark-800 border border-dark-700 rounded-xl px-3 py-2 text-sm text-white focus:outline-none">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-400 mb-1">File Size</label>
            <input type="text" id="file_size" placeholder="64 MB / 1.8 GB" class="w-full bg-dark-800 border border-dark-700 rounded-xl px-3 py-2 text-sm text-white focus:outline-none">
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-slate-400 mb-1">MD5 Checksum</label>
            <input type="text" id="md5" placeholder="c282002da283..." class="w-full bg-dark-800 border border-dark-700 rounded-xl px-3 py-2 text-xs text-white font-mono focus:outline-none">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-400 mb-1">SHA256 Checksum</label>
            <input type="text" id="sha256" placeholder="a3b59f..." class="w-full bg-dark-800 border border-dark-700 rounded-xl px-3 py-2 text-xs text-white font-mono focus:outline-none">
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-1">Changelog (Markdown)</label>
          <textarea id="changelog" rows="2" placeholder="- Initial build&#10;- Fixed touchscreen in recovery" class="w-full bg-dark-800 border border-dark-700 rounded-xl px-3 py-2 text-xs text-white font-mono focus:outline-none"></textarea>
        </div>
      </div>

      <!-- MIRROR LINKS SECTION -->
      <div>
        <div class="flex items-center justify-between mb-2">
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-400">Mirror Download Links</label>
          <button type="button" onclick="addMirrorInputRow()" class="px-2.5 py-1 bg-dark-800 hover:bg-dark-700 text-brand-500 text-xs font-bold rounded-lg border border-dark-700 transition">
            + Add Link
          </button>
        </div>
        <div id="releaseMirrorsContainer" class="space-y-2">
          <!-- Dynamically populated -->
        </div>
      </div>

    </form>

    <div class="p-6 border-t border-dark-800 bg-dark-900 flex justify-end gap-3">
      <button onclick="document.getElementById('createModal').classList.add('hidden')" class="px-4 py-2 bg-dark-800 hover:bg-dark-700 text-slate-300 text-xs font-semibold rounded-xl transition">
        Cancel
      </button>
      <button onclick="submitRelease()" class="px-6 py-2 bg-brand-500 hover:bg-brand-600 text-white text-xs font-semibold rounded-xl transition shadow-lg shadow-brand-500/20">
        Publish Release
      </button>
    </div>

  </div>
</div>

<script>
  const globalHosts = <%- JSON.stringify(hosts) %>;

  document.addEventListener('DOMContentLoaded', () => {
    // Initialize Spotify-style drag-and-drop Universal Host queue
    const hostListEl = document.getElementById('universalHostsList');
    Sortable.create(hostListEl, {
      animation: 150,
      handle: '.drag-handle',
      ghostClass: 'ghost-item',
      onEnd: async () => {
        updateHostRanks();
        await saveUniversalHostOrder();
      }
    });

    // Populate initial mirror input rows in modal
    addMirrorInputRow('GitHub Releases', '');
    addMirrorInputRow('Catbox', '');
    addMirrorInputRow('Google Drive', '');
  });

  function updateHostRanks() {
    const items = document.querySelectorAll('.host-item');
    items.forEach((item, i) => {
      item.querySelector('.host-rank').innerText = '#' + (i + 1);
    });
  }

  async function saveUniversalHostOrder() {
    const items = document.querySelectorAll('.host-item');
    const orderedHostIds = Array.from(items).map(el => parseInt(el.getAttribute('data-id')));
    
    const res = await fetch('/admin/hosts/reorder', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ orderedHostIds })
    });

    if (res.ok) {
      const status = document.getElementById('saveStatus');
      status.classList.remove('hidden');
      setTimeout(() => status.classList.add('hidden'), 2000);
    }
  }

  async function addCustomHost() {
    const nameInput = document.getElementById('newHostName');
    const name = nameInput.value.trim();
    if (!name) return;

    const res = await fetch('/admin/hosts/add', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name })
    });

    if (res.ok) {
      window.location.reload();
    } else {
      alert('Could not add host (already exists)');
    }
  }

  async function deleteHost(id) {
    if (!confirm('Remove this host from universal list?')) return;
    const res = await fetch('/admin/hosts/' + id + '/delete', { method: 'POST' });
    if (res.ok) window.location.reload();
  }

  function toggleMode(mode) {
    const complexFields = document.getElementById('complexFields');
    if (mode === 'simple') {
      complexFields.classList.add('hidden');
    } else {
      complexFields.classList.remove('hidden');
    }
  }

  function addMirrorInputRow(provider = '', url = '') {
    const container = document.getElementById('releaseMirrorsContainer');
    const row = document.createElement('div');
    row.className = 'mirror-input-row flex items-center gap-2 p-2 bg-dark-950 border border-dark-800 rounded-xl';
    
    let hostOptions = globalHosts.map(h => 
      \`<option value="\${h.name}" \${h.name.toLowerCase() === provider.toLowerCase() ? 'selected' : ''}>\${h.name}</option>\`
    ).join('');

    row.innerHTML = \`
      <select class="mirror-provider bg-dark-800 border border-dark-700 rounded-lg px-2.5 py-1.5 text-xs text-white focus:outline-none">
        \${hostOptions}
      </select>
      <input type="url" placeholder="Paste download URL (https://...)" value="\${url}" class="mirror-url flex-grow bg-dark-800 border border-dark-700 rounded-lg px-2.5 py-1.5 text-xs text-white focus:outline-none focus:border-brand-500">
      <button type="button" onclick="this.closest('.mirror-input-row').remove();" class="text-slate-500 hover:text-red-400 p-1.5 transition">
        <i class="fa-solid fa-trash-can"></i>
      </button>
    \`;
    container.appendChild(row);
  }

  async function submitRelease() {
    const mode = document.querySelector('input[name="mode"]:checked').value;
    const title = document.getElementById('title').value.trim();
    const slug = document.getElementById('slug').value.trim();

    if (!title || !slug) {
      alert('Please fill out the Title and URL Slug.');
      return;
    }

    const rows = document.querySelectorAll('.mirror-input-row');
    const mirrors = [];
    rows.forEach(r => {
      const provider = r.querySelector('.mirror-provider').value;
      const url = r.querySelector('.mirror-url').value.trim();
      if (url) mirrors.push({ provider, url });
    });

    const payload = {
      title,
      slug,
      mode,
      device: document.getElementById('device').value,
      version: document.getElementById('version').value,
      file_size: document.getElementById('file_size').value,
      md5: document.getElementById('md5').value,
      sha256: document.getElementById('sha256').value,
      changelog: document.getElementById('changelog').value,
      mirrors
    };

    const res = await fetch('/admin/release', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });

    if (res.ok) {
      window.location.reload();
    } else {
      alert('Failed to save release. Ensure slug is unique.');
    }
  }

  function copyBBCode(title, url) {
    const bbcode = \`[SIZE=4][B]\${title}[/B][/SIZE]\n[URL='\${url}'][B][COLOR=#f97316]Download via Mirrors (Fast & Direct)[/COLOR][/B][/URL]\`;
    navigator.clipboard.writeText(bbcode);
    alert('Copied XDA BBCode to clipboard!');
  }
</script>
` }) %>
